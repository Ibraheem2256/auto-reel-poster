# =========================================================
# Auto Reel Poster — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit real credentials.
# =========================================================

# --- Database (Supabase free tier) ---
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# --- Auth ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
OAUTH_STATE_SECRET="another-random-string"

# --- Google (used for Drive + YouTube + Google sign-in) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Drive scopes used: https://www.googleapis.com/auth/drive.readonly
# YouTube scopes used: https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Required scopes: user.info.basic, video.publish

# --- Meta (Instagram + Facebook) ---
META_APP_ID=""
META_APP_SECRET=""
# Instagram scopes: instagram_basic, instagram_content_publish
# Facebook scopes: pages_show_list, pages_manage_posts, pages_read_engagement

# --- Queue (Upstash free tier, optional but recommended) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Temporary storage (optional; S3-compatible, e.g. Supabase Storage / Cloudflare R2 / MinIO) ---
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""

# --- Optional AI (OpenAI-compatible API for caption/hashtag/title/description generation) ---
# The model must support vision (image input) for video-content analysis,
# e.g. gpt-4o-mini, gpt-4o, or OpenRouter: openai/gpt-4o-mini with AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Cron authentication (must match what your cron provider sends) ---
CRON_SECRET="change-me-to-a-long-random-string"

# --- Misc ---
LOG_LEVEL="info"
# Drive scan interval in minutes (minimum 5)
SCAN_INTERVAL_MINUTES="10"