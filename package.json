{
  "name": "auto-reel-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Free-first SaaS that auto-publishes Google Drive videos to TikTok, YouTube Shorts, Instagram Reels and Facebook Reels on a daily schedule. Zero permanent video storage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "prisma generate && prisma db push --skip-generate && next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local": "node scripts/start-db.mjs",
    "db:local:stop": "node scripts/start-db.mjs stop",
    "cron:scan": "tsx scripts/cron.ts scan",
    "cron:publish": "tsx scripts/cron.ts publish",
    "cron:check": "tsx scripts/cron.ts check-status",
    "cron:retry": "tsx scripts/cron.ts retry",
    "cron:cleanup": "tsx scripts/cron.ts cleanup",
    "cron:tokencheck": "tsx scripts/cron.ts token-check",
    "cron:daemon": "tsx scripts/cron-daemon.ts",
    "user:update": "tsx scripts/update-user.ts",
    "test:motion": "tsx scripts/test-motion.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "next-auth": "^4.24.11",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
